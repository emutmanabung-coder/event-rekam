/* ───────── database (IndexedDB) ───────── */
const DB = (() => {
  let db;
  const open = () => new Promise((res, rej) => {
    const r = indexedDB.open('event-survei', 1);
    r.onupgradeneeded = () => {
      const d = r.result;
      d.createObjectStore('ruas', { keyPath: 'no' });
      d.createObjectStore('surveys', { keyPath: 'id' });
    };
    r.onsuccess = () => { db = r.result; res(); };
    r.onerror = () => rej(r.error);
  });
  const all = store => new Promise((res, rej) => {
    const q = db.transaction(store).objectStore(store).getAll();
    q.onsuccess = () => res(q.result); q.onerror = () => rej(q.error);
  });
  const put = (store, val) => new Promise((res, rej) => {
    const tx = db.transaction(store, 'readwrite'); tx.objectStore(store).put(val);
    tx.oncomplete = res; tx.onerror = () => rej(tx.error);
  });
  const del = (store, key) => new Promise((res, rej) => {
    const tx = db.transaction(store, 'readwrite'); tx.objectStore(store).delete(key);
    tx.oncomplete = res; tx.onerror = () => rej(tx.error);
  });
  return { open, all, put, del };
})();

