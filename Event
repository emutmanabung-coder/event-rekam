/* STA estimasi untuk sebuah event (hanya survei yang sudah selesai) */
function estSta(s, ev) {
  if (!s.end) return null;
  let f;
  if (s.dist >= 50 && ev.d !== undefined && ev.d !== null) f = ev.d / s.dist;
  else { const T = s.end - s.start; if (T <= 0) return null; f = (ev.t - s.start) / T; }
  f = Math.min(1, Math.max(0, f));
  return s.staAwal + f * (s.staAkhir - s.staAwal);
}

