function fmtDate(t) { const d = new Date(t); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
function fmtTime(t) { const d = new Date(t); return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`; }
function fmtDur(ms) { const s = Math.max(0, Math.floor(ms / 1000)); return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`; }
function fmtSta(m) {
  if (m === null || m === undefined || isNaN(m)) return '';
  const neg = m < 0, a = Math.round(Math.abs(m));
  return `${neg ? '-' : ''}${Math.floor(a / 1000)}+${pad3(a % 1000)}`;
}
function pad3(n) { return String(n).padStart(3, '0'); }
/* "12+300" -> 12300 ;  "12300" -> 12300 (meter) */
function parseSta(str) {
  const s = String(str || '').trim().replace(',', '.');
  let m = s.match(/^(\d+)\s*\+\s*(\d{1,3}(?:\.\d+)?)$/);
  if (m) return parseInt(m[1], 10) * 1000 + parseFloat(m[2]);
  if (/^\d+(\.\d+)?$/.test(s)) return parseFloat(s);
  return null;
}

