/* ───────── layar survei (pencatatan event) ───────── */
const live = { timer: null, watch: null, wake: null, fix: null, lastPos: null, gps: 'off', dirty: false, saveT: null, subT: null, s: null };

function stopLive() {
  clearInterval(live.timer); clearInterval(live.saveT); clearTimeout(live.subT);
  if (live.watch !== null) { try { navigator.geolocation.clearWatch(live.watch); } catch (e) { /* abaikan */ } }
  if (live.wake) { try { live.wake.release(); } catch (e) { /* abaikan */ } }
  if (live.s && live.dirty) saveSurvey(live.s);
  Object.assign(live, { timer: null, watch: null, wake: null, fix: null, lastPos: null, gps: 'off', dirty: false, saveT: null, subT: null, s: null });
}
const hav = (a, b) => {
  const R = 6371000, rad = x => x * Math.PI / 180;
  const dLa = rad(b.lat - a.lat), dLo = rad(b.lon - a.lon);
  const h = Math.sin(dLa / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLo / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
};
function setGps(st) {
  live.gps = st;
  const el = $('#gps'); if (!el) return;
  el.innerHTML = `<span class="dot ${st === 'ok' ? 'ok' : st === 'weak' ? 'weak' : ''}"></span>${st === 'ok' ? 'GPS' : st === 'weak' ? 'Lemah' : 'Off'}`;
}
function startGps() {
  if (!navigator.geolocation) { setGps('off'); return; }
  live.watch = navigator.geolocation.watchPosition(p => {
    const s = live.s; if (!s || s.end) return;
    const pos = { lat: p.coords.latitude, lon: p.coords.longitude, acc: p.coords.accuracy, t: Date.now() };
    if (pos.acc > 40) { setGps('weak'); if (pos.acc <= 100) live.lastPos = pos; return; }
    setGps('ok'); live.lastPos = pos;
    if (live.fix) {
      const d = hav(live.fix, pos);
      if (d >= 4 && d < 300) { s.dist += d; live.fix = pos; live.dirty = true; }
    } else live.fix = pos;
  }, () => setGps('off'), { enableHighAccuracy: true, maximumAge: 2000, timeout: 20000 });
}
async function keepAwake() {
  try { if (navigator.wakeLock && !live.s.end) live.wake = await navigator.wakeLock.request('screen'); } catch (e) { /* abaikan */ }
}

