/* ───────── router ───────── */
function route() {
  stopLive(); closeModal();
  if (!loggedIn()) { viewLogin(); return; }
  const [, p, arg] = location.hash.split('/');
  const a = arg ? decodeURIComponent(arg) : '';
  if (p === 'survey' && a) viewSurvey(a);
  else if (p === 'ruas' && a) viewRuasDetail(a);
  else if (p === 'db') viewDb();
  else if (p === 'about') viewAbout();
  else viewRuas();
  window.scrollTo(0, 0);
}
window.addEventListener('hashchange', route);
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && live.s && !live.s.end && !live.wake) keepAwake();
  if (document.visibilityState === 'hidden' && live.s && live.dirty) { saveSurvey(live.s); live.dirty = false; }
});

(async function init() {
  try { await DB.open(); } catch (e) { app.innerHTML = '<div class="empty">Penyimpanan lokal tidak tersedia di peramban ini.</div>'; return; }
  [state.ruas, state.surveys] = await Promise.all([DB.all('ruas'), DB.all('surveys')]);
  try { navigator.storage && navigator.storage.persist && navigator.storage.persist(); } catch (e) { /* abaikan */ }
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => { /* abaikan */ });
  route();
})();

