/* ───────── database / ekspor ───────── */
function buildRows(ruasNo, surveyId) {
  let ss = state.surveys.slice().sort((a, b) => a.ruas.localeCompare(b.ruas, undefined, { numeric: true }) || a.created - b.created);
  if (ruasNo && ruasNo !== '*') ss = ss.filter(s => s.ruas === ruasNo);
  if (surveyId) ss = ss.filter(s => s.id === surveyId);
  const evHead = ['No', 'Nomor Ruas', 'Nama Ruas', 'Lajur', 'Pengulangan', 'STA Awal', 'STA Akhir', 'Tanggal', 'Jam', 'Kode Event', 'Keterangan Event', 'Rincian', 'Estimasi STA', 'Jarak GPS (m)', 'Latitude', 'Longitude'];
  const evRows = [evHead]; let n = 0;
  const svHead = ['Nomor Ruas', 'Nama Ruas', 'Lajur', 'Pengulangan', 'STA Awal', 'STA Akhir', 'Mulai', 'Selesai', 'Durasi', 'Jarak GPS (m)', 'Jumlah Event', 'Status'];
  const svRows = [svHead];
  for (const s of ss) {
    const r = ruasOf(s.ruas) || {};
    svRows.push([s.ruas, r.nama || '', s.lajur === 'opposite' ? 'Opposite' : 'Normal', s.ulang, fmtSta(s.staAwal), fmtSta(s.staAkhir),
      `${fmtDate(s.start)} ${fmtTime(s.start)}`, s.end ? `${fmtDate(s.end)} ${fmtTime(s.end)}` : '', s.end ? fmtDur(s.end - s.start) : '',
      Math.round(s.dist), s.events.length, s.end ? 'Selesai' : 'Berjalan']);
    for (const e of s.events) {
      const def = evByCode(e.code) || {};
      evRows.push([++n, s.ruas, r.nama || '', s.lajur === 'opposite' ? 'Opposite' : 'Normal', s.ulang, fmtSta(s.staAwal), fmtSta(s.staAkhir),
        fmtDate(e.t), fmtTime(e.t), e.code, def.full || '', e.sub || '', fmtSta(estSta(s, e)), e.d ?? '', e.lat ?? '', e.lon ?? '']);
    }
  }
  const legend = [['Kelompok', 'Kode', 'Keterangan']];
  EVENT_GROUPS.forEach(g => g.events.forEach(e => legend.push([g.title, e.code, e.full])));
  return { evRows, svRows, legend };
}

function download(name, data, type) {
  const url = URL.createObjectURL(new Blob([data], { type }));
  const a = document.createElement('a'); a.href = url; a.download = name; document.body.appendChild(a); a.click();
  setTimeout(() => { a.remove(); URL.revokeObjectURL(url); }, 4000);
}
const stamp = () => { const d = new Date(); return `${fmtDate(d)}_${pad(d.getHours())}${pad(d.getMinutes())}`; };
const safe = s => String(s).replace(/[^\w.-]+/g, '_');

function exportXlsx(ruasNo, surveyId) {
  const { evRows, svRows, legend } = buildRows(ruasNo, surveyId);
  if (evRows.length < 2 && svRows.length < 2) { toast('Belum ada data'); return; }
  const bytes = XLSX.build([
    { name: 'Event', rows: evRows, widths: [6, 12, 22, 10, 12, 10, 10, 12, 10, 11, 38, 10, 13, 13, 12, 12] },
    { name: 'Survei', rows: svRows, widths: [12, 22, 10, 12, 10, 10, 20, 20, 10, 13, 13, 10] },
    { name: 'Keterangan Event', rows: legend, widths: [12, 10, 48] }
  ]);
  const tag = ruasNo && ruasNo !== '*' ? 'Ruas' + safe(ruasNo) : 'SemuaRuas';
  download(`Event_${tag}_${stamp()}.xlsx`, bytes, 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
  toast('File Excel dibuat');
}
const csvCell = v => { const s = String(v ?? ''); return /[",\n;]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
function exportCsv(ruasNo) {
  const { evRows } = buildRows(ruasNo);
  if (evRows.length < 2) { toast('Belum ada event'); return; }
  const tag = ruasNo && ruasNo !== '*' ? 'Ruas' + safe(ruasNo) : 'SemuaRuas';
  download(`Event_${tag}_${stamp()}.csv`, '﻿' + evRows.map(r => r.map(csvCell).join(',')).join('\r\n'), 'text/csv;charset=utf-8');
  toast('File CSV dibuat');
}
function exportJson() {
  download(`Cadangan_EventSurvei_${stamp()}.json`, JSON.stringify({ app: 'event-survei', v: 1, ruas: state.ruas, surveys: state.surveys }), 'application/json');
  toast('Cadangan dibuat');
}
function importJson() {
  const inp = document.createElement('input'); inp.type = 'file'; inp.accept = '.json,application/json';
  inp.onchange = async () => {
    try {
      const j = JSON.parse(await inp.files[0].text());
      if (j.app !== 'event-survei') throw new Error('bukan file cadangan');
      for (const r of j.ruas || []) if (!ruasOf(r.no)) { await saveRuas(r); state.ruas.push(r); }
      let add = 0;
      for (const s of j.surveys || []) {
        const i = state.surveys.findIndex(x => x.id === s.id);
        if (i < 0) { state.surveys.push(s); add++; } else if ((s.events || []).length > state.surveys[i].events.length) state.surveys[i] = s; else continue;
        await saveSurvey(s);
      }
      toast(`Impor selesai (${add} survei baru)`); route();
    } catch (e) { toast('File cadangan tidak valid'); }
  };
  inp.click();
}

let dbSel = '*';
function viewDb() {
  if (dbSel !== '*' && !ruasOf(dbSel)) dbSel = '*';
  const { evRows, svRows } = buildRows(dbSel);
  const opts = ['<option value="*">Semua ruas</option>', ...state.ruas.sort((a, b) => a.no.localeCompare(b.no, undefined, { numeric: true })).map(r => `<option value="${esc(r.no)}" ${r.no === dbSel ? 'selected' : ''}>Ruas ${esc(r.no)}${r.nama ? ' — ' + esc(r.nama) : ''}</option>`)];
  const cols = [0, 1, 3, 4, 7, 8, 9, 11, 12];
  const table = rows => `<div class="tbl"><table><thead><tr>${cols.map(i => `<th>${esc(evRows[0][i])}</th>`).join('')}</tr></thead><tbody>${rows.slice(1).slice(-300).map(r => `<tr>${cols.map(i => `<td class="${i === 0 ? 'num' : ''}">${esc(r[i])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
  const body = `
    <div class="card"><label class="f" for="dsel" style="margin-top:0">Tampilkan data</label><select id="dsel">${opts.join('')}</select>
      <p class="muted small" style="margin:8px 0 0">${svRows.length - 1} survei · ${evRows.length - 1} event${evRows.length > 301 ? ' (tabel menampilkan 300 terakhir; ekspor memuat semua)' : ''}</p></div>
    ${evRows.length > 1 ? table(evRows) : '<div class="empty">Belum ada data event.</div>'}
    <div class="grp">Ekspor &amp; cadangan</div>
    <div class="row" style="flex-wrap:wrap">
      <button class="btn grow" id="xl">⬇ Excel (.xlsx)</button><button class="btn alt grow" id="cs">⬇ CSV</button></div>
    <div class="row" style="margin-top:10px;flex-wrap:wrap">
      <button class="btn ghost grow sm" id="bk">Cadangan (.json)</button><button class="btn ghost grow sm" id="im">Pulihkan cadangan</button></div>
    <p class="muted small">Data tersimpan di perangkat ini. Rutin ekspor / cadangkan agar aman bila data peramban terhapus.</p>`;
  shell('Database', 'Sheet data event tersimpan', body);
  $('#dsel').onchange = e => { dbSel = e.target.value; viewDb(); };
  $('#xl').onclick = () => exportXlsx(dbSel); $('#cs').onclick = () => exportCsv(dbSel);
  $('#bk').onclick = exportJson; $('#im').onclick = importJson;
}

